# Token HyperSync untuk Monad testnet (https://envio.dev/app/api-tokens). Isi di .env atau Envio Cloud, jangan di-commit.
ENVIO_API_TOKEN=
# Kosongkan untuk memakai deploy testnet di config.yaml; isi bila deploy ulang (deployments/10143.json di repo contracts)
ENVIO_FK_ADDRESS=
ENVIO_TIDRX_ADDRESS=
ENVIO_START_BLOCK=
# RPC anvil lokal (chain 31337)
ENVIO_ANVIL_RPC=http://127.0.0.1:8545
