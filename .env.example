# HyperSync token for Monad testnet (https://envio.dev/app/api-tokens). Set it in .env or Envio Cloud, never commit it.
ENVIO_API_TOKEN=
# Leave empty to use the testnet deploy in config.yaml; set when redeploying (deployments/10143.json in the contracts repo)
ENVIO_FK_ADDRESS=
ENVIO_TIDRX_ADDRESS=
ENVIO_START_BLOCK=
# Local anvil RPC (chain 31337)
ENVIO_ANVIL_RPC=http://127.0.0.1:8545
